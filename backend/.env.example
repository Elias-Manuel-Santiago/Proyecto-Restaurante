# ---------- Modo local (XAMPP) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=restaurante
PORT=3005
FRONTEND_ORIGIN=http://localhost:5173
SESSION_HOURS=8
# Definir solo en el .env local; no se incluye ninguna contraseña predeterminada.
ADMIN_USERNAME=elias
ADMIN_NAME=Elías Manuel Santiago
ADMIN_PASSWORD=
# Opcional: npm run seed:equipo. También se admiten claves individuales:
# SEED_PASSWORD_MARTIN, SEED_PASSWORD_LAUREANO, SEED_PASSWORD_SANTIAGO, SEED_PASSWORD_NEHUEN
SEED_EQUIPO_PASSWORD=
# Opcional: lista de cuentas en JSON, por ejemplo
# SEED_EQUIPO=[{"username":"martin","name":"Martín Porcelli","role":"mozo"}]
SEED_EQUIPO=

# Checkout Pro: Access Token del vendedor de PRUEBA (no Public Key).
MP_ACCESS_TOKEN=
# IDs de compradores copiados de Cuentas de prueba; necesarios si MP devuelve live_mode=true.
MP_TEST_BUYER_IDS=

# ---------- Modo online (se cargan en el panel del hosting, no en un archivo) ----------
# NODE_ENV=production        -> cookie Secure, HSTS y Express sirve frontend/dist
# FRONTEND_ORIGIN=https://<tu-servicio>.onrender.com   (misma URL pública: se usa en back_urls de MP)
# TRUST_PROXY=1              -> cantidad de proxies delante (Render: 1). En producción vale 1 por defecto.
# TZ=America/Argentina/Buenos_Aires
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_DATABASE -> los datos del MySQL en la nube
# SERVIR_FRONTEND=0          -> solo si el frontend se publica aparte
