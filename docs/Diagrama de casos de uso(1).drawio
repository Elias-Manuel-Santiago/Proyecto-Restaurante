        <mxCell id="note-0" value="UC07, UC08 y UC19 incluyen UC55 antes de guardar: los platos deben estar habilitados y los insumos de sus recetas deben alcanzar para las cantidades solicitadas." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1020" width="690" height="100" />
        </mxCell>
        <mxCell id="note-1" value="Al editar se considera lo que el pedido ya había reservado. Los platos sin receta no requieren insumos; la comprobación sigue validando su disponibilidad manual." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1135" width="690" height="100" />
        </mxCell>
        <mxCell id="note-2" value="Los actores y permisos de los casos base se conservan en las páginas 02 y 05. UC55 es una operación interna compartida; no concede permisos para ajustar stock manualmente." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1250" width="690" height="100" />
        </mxCell>
