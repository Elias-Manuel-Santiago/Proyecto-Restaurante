        <mxCell id="note-0" value="Registrar o editar pedidos incluye verificar disponibilidad (página 10) y consume o ajusta insumos; cancelar repone lo descontado. No son acciones manuales del mozo o chef." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1020" width="690" height="100" />
        </mxCell>
        <mxCell id="note-1" value="Configurar receta permite crearla, reemplazarla o quitarla. Ajustar existencias registra reposiciones o mermas. No se agregan bajas de insumos o unidades que el sistema no ofrece." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1135" width="690" height="100" />
        </mxCell>
        <mxCell id="note-2" value="Editar insumo está disponible en la API del administrador. La interfaz actual no ofrece un formulario para modificar su nombre o unidad." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
