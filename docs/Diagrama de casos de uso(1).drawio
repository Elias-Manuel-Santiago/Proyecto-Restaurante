        </mxCell>
        <mxCell id="note-0" value="Repartidor = personal interno con cuenta y envíos asignados. La cadetería externa no tiene acceso: mozo o administrador registra su salida y confirma su entrega." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1444" width="690" height="100" />
        </mxCell>
        <mxCell id="note-1" value="Retirar exige pedido listo y pago aprobado; entregar a domicilio exige envío en camino. En retiro en local, mozo o administrador confirma directamente el retiro." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1559" width="690" height="100" />
        </mxCell>
        <mxCell id="note-2" value="Registrar el pedido incluye consultar modalidades. Dirección y repartidor se completan según la modalidad. Ver el detalle «include» y «extend» en la página 09." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
