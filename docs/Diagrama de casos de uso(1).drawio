        <mxCell id="subtitle" value="Tres inclusiones del mismo comportamiento · Detalle de las páginas 02 y 05" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#24334b;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;">
