        <mxCell id="subtitle" value="Integración con pasarela externa · Mercado Pago en entorno de prueba" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#24334b;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;">
          <mxGeometry as="geometry" x="65" y="99" width="1270" height="50" />
        </mxCell>
        <mxCell id="note-0" value="Mozo y administrador operan el cobro. Mercado Pago participa como sistema externo. El cliente paga en el checkout externo mediante enlace o QR, sin cuenta en NÁCAR." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="914" width="690" height="100" />
        </mxCell>
        <mxCell id="note-1" value="La aprobación se verifica consultando la pasarela; un clic o retorno del navegador no acredita el pago. Envío y retiro exigen prepago; las mesas no lo exigen en el circuito actual." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1029" width="690" height="100" />
        </mxCell>
        <mxCell id="note-2" value="Cancelar y reembolsar incluye solicitar el reembolso a la pasarela y exige que no se haya despachado o entregado. La devolución puede quedar pendiente." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1144" width="690" height="100" />
        </mxCell>
        <mxCell id="footer" value="Asociación: línea continua sin flecha · Los códigos UC identifican el mismo caso en todas las páginas." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#24334b;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;">
