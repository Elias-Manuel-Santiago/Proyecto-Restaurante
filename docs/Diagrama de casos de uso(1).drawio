        <mxCell id="subtitle" value="Cuentas del personal, mesas, indicadores y resúmenes guardados" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#24334b;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;">
          <mxGeometry as="geometry" x="65" y="99" width="1270" height="50" />
        </mxCell>
        <mxCell id="note-0" value="La baja de usuario desactiva la cuenta y revoca sus sesiones. Se conservan al menos un administrador activo y las referencias históricas; no se permite la propia desactivación." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1550" width="690" height="100" />
        </mxCell>
        <mxCell id="note-1" value="La baja de mesa es lógica y exige que esté desocupada. Editar mesa cambia número o capacidad; no equivale a modificar los comensales de la visita." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1665" width="690" height="100" />
        </mxCell>
        <mxCell id="note-2" value="El consumo mostrado en estadísticas no equivale a cobros ni a ganancia neta. Los resúmenes guardados se registran por separado con importes ingresados explícitamente." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1780" width="690" height="100" />
        </mxCell>
