        <mxCell id="subtitle" value="Detalle de UC19 · Los mismos actores y casos de la vista de envíos" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#24334b;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;">
          <mxGeometry as="geometry" x="65" y="99" width="1270" height="50" />
        </mxCell>
        <mxCell id="note-0" value="UC53 extiende UC19 en «Completar datos de entrega» si la modalidad requiere dirección. UC54 lo extiende en «Completar datos de reparto» si requiere repartidor interno." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1020" width="690" height="100" />
        </mxCell>
        <mxCell id="note-1" value="Las extensiones son condicionales: cuando se cumple su condición deben completarse antes de registrar el pedido. En retiro en local no se ejecutan estas extensiones." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
          <mxGeometry as="geometry" x="330" y="1135" width="690" height="100" />
        </mxCell>
        <mxCell id="note-2" value="Flecha discontinua «include»: del caso base al incluido. Flecha discontinua «extend»: de la extensión al caso base. UC19 y UC26 conservan sus códigos de la página 05." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#24334b;shape=note;size=16;fillColor=#fff8e5;strokeColor=#bd9637;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=18;">
