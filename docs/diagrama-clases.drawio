        <mxCell id="reglas" value="EstadoEnvio = pendiente | en_camino | entregado.&lt;br/&gt;Moto propia exige dirección y repartidor activo.&lt;br/&gt;Cadetería exige dirección, sin repartidor interno.&lt;br/&gt;Retiro local: sin dirección ni repartidor.&lt;br/&gt;El costo aplicado se conserva al cambiar la tarifa." vertex="1" parent="1" style="shape=note;size=16;html=1;whiteSpace=wrap;fillColor=#fff8e5;strokeColor=#bd9637;fontFamily=Arial;fontSize=16;fontColor=#24334b;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;">
