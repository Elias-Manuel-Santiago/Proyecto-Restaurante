        <mxCell id="reglas" value="EstadoPedido = pendiente | preparacion | listo | entregado | cancelado. EstadoMesa = ocupada | desocupada.&lt;br/&gt;Un pedido pertenece a una mesa o tiene un envío. DetallePedido conserva nombre y precio históricos.&lt;br/&gt;/porciones es calculado; null indica que no hay receta. FormaMesa = rectangle | circle." vertex="1" parent="1" style="shape=note;size=16;html=1;whiteSpace=wrap;fillColor=#fff8e5;strokeColor=#bd9637;fontFamily=Arial;fontSize=16;fontColor=#24334b;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;">
